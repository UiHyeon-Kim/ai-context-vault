<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.ai-vault-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/tunnel-client</string>
    <string>run</string>
    <string>--profile-dir</string><string>/ABSOLUTE/PATH/profiles</string>
    <string>--profile</string><string>ai-vault</string>
    <string>--pid.file</string><string>/ABSOLUTE/PATH/ai-vault.pid</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/ABSOLUTE/PATH</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/ai-vault.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/ai-vault.stderr.log</string>
</dict>
</plist>
